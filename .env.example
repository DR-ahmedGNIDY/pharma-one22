# MongoDB
MONGODB_URI=mongodb://localhost:27017/pharma-one

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public site URL — MUST be the exact production origin (no trailing slash).
# Used for canonical tags, sitemap URLs, robots.txt and JSON-LD @id values.
# Getting this wrong silently mis-canonicalises every page on the site.
NEXT_PUBLIC_SITE_URL=https://pharma1cosmetic.com

# Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=
